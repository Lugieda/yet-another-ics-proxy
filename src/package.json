{
  "name": "yet-another-ics-proxy",
  "version": "1.0.0",
  "description": "A lightweight and stateless ICS proxy running on Alpine Linux",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:dev": "tsc --watch",
    "start": "node dist/server.js",
    "start:dev": "node --env-file=.env --watch dist/server.js"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "windows-iana": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
