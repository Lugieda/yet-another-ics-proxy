{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"],
    "noImplicitAny": true
  },
  "include": ["server.ts", "modules/**/**.ts"]
}
